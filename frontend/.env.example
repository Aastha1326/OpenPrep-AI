# -----------------------------------------------------------------------------
# Frontend Environment Variables
# -----------------------------------------------------------------------------

# Base URL of the Express REST API. The Socket.IO URL is derived by stripping '/api'.
# In local development, this is typically http://localhost:5000/api
# In production (e.g. on Vercel), MUST be set to the absolute URL of the deployed backend.
# IMPORTANT: Never use a relative path like '/api' when deploying the frontend separately.
# VITE_API_URL=http://localhost:5000/api

# Google OAuth Client ID
# VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Sentry Configuration
# VITE_SENTRY_DSN=your_sentry_dsn_here
# VITE_SENTRY_ENVIRONMENT=production
