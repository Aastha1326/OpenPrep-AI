        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "sum(rate(http_request_duration_seconds_count{status_code=~\"4..\"}[1m]))",
          "legendFormat": "4xx Errors"
        }
      ]
    },
