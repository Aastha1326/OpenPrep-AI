      },
      "id": 3,
      "title": "HTTP Error Rate (5xx / 4xx)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "sum(rate(http_request_duration_seconds_count{status_code=~\"5..\"}[1m]))",
