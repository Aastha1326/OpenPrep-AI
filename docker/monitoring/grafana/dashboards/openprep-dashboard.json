      "title": "HTTP QPS / Throughput",
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "sum(rate(http_request_duration_seconds_count[1m]))",
          "legendFormat": "Req/sec"
        }
      ]
    },
