# --- Server ---
PORT=5000
NODE_ENV=development

# --- PostgreSQL (required -- server exits if it cannot connect) ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/openprep

# --- JWT (required -- server exits if unset) ---
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRE=15m

# --- CORS (optional -- defaults to http://localhost:5173) ---
# CLIENT_ORIGIN=https://your-app.vercel.app,https://staging.your-app.vercel.app  # Comma-separated whitelist (preferred)
# CLIENT_URL=https://your-app.vercel.app   # Primary frontend URL (production/staging)
# CORS_ORIGIN=http://localhost:5173         # Legacy override; use CLIENT_ORIGIN instead# Note: *.vercel.app and *.openprep.ai preview URLs are allowed automatically

# --- OAuth / Frontend URL (optional -- defaults to http://localhost:5173) ---
# FRONTEND_URL=http://localhost:5173        # Redirect target after Google OAuth & email verification
# GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your_google_client_secret

# --- Redis (optional -- falls back to DB-only when unreachable) ---
REDIS_URL=redis://127.0.0.1:6379

# --- Gemini API (optional -- falls back to mock data) ---
# GEMINI_API_KEY=your_gemini_api_key_here

# --- SMTP / Email (optional -- falls back to console in dev) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false     # true for implicit TLS on port 465
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password
# SMTP_FROM="OpenPrep AI <noreply@openprep.ai>"

# --- Web Push Notifications (optional -- embedded dev keys are used as fallback) ---
# VAPID_PUBLIC_KEY=your_vapid_public_key
# VAPID_PRIVATE_KEY=your_vapid_private_key
# VAPID_SUBJECT=mailto:admin@openprep-ai.com

# --- Caching (optional) ---
CACHE_ENABLED=true
# CACHE_TTL=3600
# CACHE_MAX_KEYS=1000

# --- Testing (optional -- only relevant when NODE_ENV=test) ---
# ENABLE_RATE_LIMIT_TESTS=true
